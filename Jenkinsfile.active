// Jenkinsfile.active -- ACTIVE scan variant, run as a SEPARATE Jenkins job.


pipeline {
    agent any

    environment {
        PATH = "/opt/homebrew/bin:/usr/local/bin:${env.PATH}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                sh 'rm -f ai_triage_report_active.md zap_report_active.json'
            }
        }

        stage('Start target app') {
            steps {
                sh 'docker compose up -d'
                sh 'sleep 15'
            }
        }

        stage('Run ZAP ACTIVE scan') {
            steps {
                sh '''
                    docker run --rm \
                      -v $(pwd):/zap/wrk/:rw \
                      zaproxy/zap-stable zap-full-scan.py \
                      -t http://host.docker.internal:3000 \
                      -J zap_report_active.json || true
                '''
                // zap-full-scan.py actively attacks the app (spider + active
                // scan rules: XSS, SQLi, etc.), unlike the passive baseline
                // scan. Exit code ignored by design -- AI triage decides
                // pass/fail.
            }
        }

        stage('Pull free local AI model (first run only)') {
            steps {
                sh 'ollama pull phi3 || true'
            }
        }

        stage('AI-assisted triage') {
            steps {
                script {
                    env.TRIAGE_EXIT_CODE = sh(
                        script: '''
                            python3 -m venv venv
                            source venv/bin/activate
                            pip install -r requirements.txt
                            python3 triage_ai_local.py zap_report_active.json
                            mv ai_triage_report.md ai_triage_report_active.md
                        ''',
                        returnStatus: true
                    ).toString()
                }
            }
        }

        stage('Publish report') {
            steps {
                archiveArtifacts artifacts: 'ai_triage_report_active.md', fingerprint: true
            }
        }

        stage('Enforce AI security gate') {
            steps {
                script {
                    if (env.TRIAGE_EXIT_CODE != '0') {
                        error("Build blocked: AI triage flagged a CRITICAL/HIGH finding from the ACTIVE scan. See ai_triage_report_active.md in Build Artifacts for details.")
                    } else {
                        echo "AI triage found no blocking issues in the active scan."
                    }
                }
            }
        }
    }

    post {
        always {
            sh 'docker compose down'
        }
    }
}